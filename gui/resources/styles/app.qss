QMainWindow,
QWidget#centralwidget,
QDialog,
QMessageBox {
    background-color: #f3f5f9;
    color: #111827;
    font-family: "Segoe UI", sans-serif;
}

QToolTip {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    padding: 4px 6px;
}

QLabel#titleLabel {
    font-size: 20px;
    font-weight: 700;
    color: #111827;
    padding: 2px 0;
}

QTabWidget::pane {
    background-color: #f3f5f9;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #e5e7eb;
    color: #374151;
    padding: 7px 16px;
    margin-right: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-bottom: none;
}

QScrollArea#dashboardScrollArea,
QWidget#dashboardGridHost {
    background-color: #f3f5f9;
    border: none;
}

QLabel#dashboardSummary {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
}

QPushButton#refreshDevicesButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton#refreshDevicesButton:hover {
    background-color: #1d4ed8;
}

QFrame#deviceCard {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

QLabel#deviceCardName {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
}

QLabel#deviceCardType {
    font-size: 12px;
    color: #6b7280;
}

QLabel#onlineBadge {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#onlineBadge[online="true"] {
    background-color: #dcfce7;
    color: #166534;
}

QLabel#onlineBadge[online="false"] {
    background-color: #fee2e2;
    color: #991b1b;
}

QLabel#metricKey,
QLabel#controlLabel {
    font-size: 13px;
    color: #4b5563;
}

QLabel#metricValue,
QLabel#controlValueLabel {
    font-size: 13px;
    font-weight: 600;
    color: #111827;
}

QFrame#cardDivider {
    background-color: #e5e7eb;
    border: none;
}

QPushButton#powerOnButton,
QPushButton#powerOffButton {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#powerOnButton:hover,
QPushButton#powerOffButton:hover {
    background-color: #e5e7eb;
}

QPushButton#powerOnButton[activePower="true"] {
    background-color: #16a34a;
    color: #ffffff;
    border-color: #15803d;
}

QPushButton#powerOffButton[activePower="true"] {
    background-color: #dc2626;
    color: #ffffff;
    border-color: #b91c1c;
}

QDoubleSpinBox#targetTempSpinBox,
QComboBox#thermostatModeCombo,
QComboBox#analyticsDeviceCombo,
QComboBox#analyticsPresetCombo,
QDateTimeEdit#analyticsStartDateTime,
QDateTimeEdit#analyticsEndDateTime {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px 8px;
    color: #111827;
    background-color: #ffffff;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #2563eb;
    color: #ffffff;
}

QLabel#deviceCardUpdatedAt {
    font-size: 11px;
    color: #9ca3af;
}

QFrame#alertBanner {
    background-color: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: 8px;
}

QLabel#alertBannerLabel {
    color: #991b1b;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#alertBannerClose {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}

QStatusBar {
    background-color: #ffffff;
    color: #374151;
    border-top: 1px solid #e5e7eb;
}

QLabel#statusBadge {
    border-radius: 6px;
    padding: 2px 8px;
    margin-left: 6px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#statusBadge[statusState="ok"] {
    background-color: #dcfce7;
    color: #166534;
}

QLabel#statusBadge[statusState="warn"] {
    background-color: #fef3c7;
    color: #92400e;
}

QLabel#statusBadge[statusState="error"] {
    background-color: #fee2e2;
    color: #991b1b;
}

QPushButton#analyticsRefreshButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton#analyticsRefreshButton:hover {
    background-color: #1d4ed8;
}

QLabel#analyticsChartStatus,
QLabel#analyticsTableTitle {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
}

QTableWidget#analyticsEventsTable {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    color: #111827;
    gridline-color: #e5e7eb;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
}

QTableWidget#analyticsEventsTable QHeaderView::section {
    background-color: #f3f4f6;
    color: #374151;
    font-weight: 600;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #e5e7eb;
}

QGroupBox#rulesSectionGroup,
QGroupBox#settingsSectionGroup {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-top: 12px;
    padding: 14px 12px 12px 12px;
    font-weight: 700;
    color: #111827;
}

QGroupBox#rulesSectionGroup::title,
QGroupBox#settingsSectionGroup::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background-color: #ffffff;
}

QLabel#rulesSummaryLabel {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
}

QPushButton#addRuleButton,
QPushButton#applyGatewayUrlButton,
QPushButton#addRuleCreateButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton#addRuleButton:hover,
QPushButton#applyGatewayUrlButton:hover,
QPushButton#addRuleCreateButton:hover {
    background-color: #1d4ed8;
}

QPushButton#refreshRulesButton {
    background-color: #f3f4f6;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
}

QPushButton#refreshRulesButton:hover {
    background-color: #e5e7eb;
}

QPushButton#deleteRuleButton {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#deleteRuleButton:hover {
    background-color: #fecaca;
}

QLineEdit#gatewayUrlEdit,
QLineEdit#addRuleIdEdit {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 5px 8px;
}

QTableWidget#rulesTable {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    color: #111827;
    gridline-color: #e5e7eb;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
}

QTableWidget#rulesTable QHeaderView::section {
    background-color: #f3f4f6;
    color: #374151;
    font-weight: 600;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #e5e7eb;
}

QLabel#addRuleErrorLabel {
    background-color: #fef2f2;
    color: #991b1b;
    border: 1px solid #fca5a5;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 600;
}

QSpinBox,
QTimeEdit {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 8px;
}

QScrollBar:vertical {
    background: #f3f5f9;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
